\\ Generate test vectors for docs/extension-certificates.md (quadratic fields, v0).
\\ PARI only *finds* generators; the C++ verifier checks them independently.
\\ Usage: gp -q gen_quadratic_vectors.gp > quadratic_vectors.txt
FMAX = 50;
\\ first prime p with M_K <= p (the frontier at which K becomes eligible)
mk(D) = if(D > 0, sqrt(D)/2, 2/Pi*sqrt(-D));
eligibleAt(D) = my(m = mk(D), p = 2); while(p < m, p = nextprime(p+1)); p;
\\ element (a + b*sqrt(D))/2 from an nf element, where nf = nfinit(x^2 - D) and x = sqrt(D)
ab(nf, e) = my(v = lift(nfbasistoalg(nf, e))); [2*polcoef(v,0), 2*polcoef(v,1)];
gens(bnf, nf, D, limit) = {
  my(out = List());
  forprime(q = 2, limit,
    if(kronecker(D, q) == -1, next);
    my(pr = idealprimedec(nf, q)[1], r = bnfisprincipal(bnf, pr, 1));
    if(r[1] != 0, return(0));                 \\ not principal: no certificate
    listput(out, concat([q], ab(nf, r[2]))));
  Vec(out);
}
fstr(f) = my(s = ""); for(i=1,#f~, s = Str(s, if(i>1,"*",""), f[i,1], "^", f[i,2])); s;
gstr(g) = my(s = ""); for(i=1,#g, s = Str(s, if(i>1,",",""), g[i][1], ":", g[i][2], ":", g[i][3])); s;
emit(D) = {
  my(F = eligibleAt(D)); if(F > FMAX, return);
  my(nf = nfinit(x^2 - D), bnf = bnfinit(x^2 - D, 1), g = gens(bnf, nf, D, floor(mk(D))));
  if(g === 0, print("NOCERT D=", D, " F=", F, " H=", bnf.no),
              print("FIELD D=", D, " F=", F, " FACTORS=", fstr(factor(abs(D))), " GENS=", gstr(g)));
}
my(v = version()); print("# quadratic fields with eligibility prime F <= ", FMAX, "; generated by PARI ", v[1], ".", v[2], ".", v[3]);
for(D = 5, ceil(4*FMAX^2), if(isfundamental(D), emit(D)));
for(n = 3, ceil((Pi*FMAX/2)^2), if(isfundamental(-n), emit(-n)));
\\ prime decomposition entries for a few fields, p < 2000
splitline(nf, bnf, D, p) = {
  my(k = kronecker(D, p), t = if(k == 1, "split", if(k == -1, "inert", "ramified")));
  if(k == -1, print("SPLIT D=", D, " P=", p, " TYPE=inert"),
     my(pr = idealprimedec(nf, p)[1], r = bnfisprincipal(bnf, pr, 1), g = ab(nf, r[2]));
     print("SPLIT D=", D, " P=", p, " TYPE=", t, " GEN=", g[1], ":", g[2]));
}
foreach([8, 5, 28, 94, -4, -3, -163], D, my(nf = nfinit(x^2 - D), bnf = bnfinit(x^2 - D, 1)); forprime(p = 2, 2000, splitline(nf, bnf, D, p)));
